
# ==========================================
# DATABASE CONFIGURATION
# ==========================================

DATABASE_URL="mysql://DB_USER:DB_PASSWORD@DB_HOST:DB_PORT/DB_NAME"

DATABASE_HOST="127.0.0.1"
DATABASE_PORT="3307"
DATABASE_USER="your_database_user"
DATABASE_PASSWORD="your_database_password"
DATABASE_NAME="amanu_properties"
DATABASE_SSL="false"


# ==========================================
# CLOUDINARY CONFIGURATION
# ==========================================

CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"


# ==========================================
# INITIAL ADMIN CONFIGURATION
# Used by the initial administrator setup process.
# Do not reuse production passwords in development.
# ==========================================

INITIAL_ADMIN_NAME="Administrator Name"
INITIAL_ADMIN_EMAIL="admin@example.com"
INITIAL_ADMIN_PASSWORD="replace_with_a_strong_password"


# ==========================================
# APPLICATION ENVIRONMENT
# ==========================================

NODE_ENV="development"
